---
import BaseNoscript from "@astro/blocks/base-noscript.astro"
import Metadata from "@astro/blocks/metadata.astro"
import MetadataConfig from "@astro/configurations/metadata.config.json"
import BaseLayout from "@astro/layouts/base-layout.astro"
import "@fontsource/roboto/300.css"
import "@fontsource/roboto/400.css"
import "@fontsource/roboto/500.css"
import "@fontsource/roboto/700.css"
import { CssBaseline, StyledEngineProvider } from "@mui/material"
import { ClientRouter } from "astro:transitions"

interface Props {
    className?: string | undefined
    description?: string | undefined
    title?: string | undefined
}

const { className, description = "", title = "" } = Astro.props
---

<!doctype html>
<html lang={MetadataConfig.language}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body class="base-body">
        <BaseNoscript />

        <StyledEngineProvider enableCssLayer injectFirst>
            <CssBaseline enableColorScheme />

            <BaseLayout className={className}>
                <slot />
            </BaseLayout>
        </StyledEngineProvider>
    </body>
</html>

<style is:global>
    @layer root, mui, components, important;

    @layer root {
        .base-body {
            width: 100svw;
            height: 100svh;
        }
    }
</style>
