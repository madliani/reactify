---
import BaseNoscript from "@astro/blocks/base-noscript.astro"
import Metadata from "@astro/blocks/metadata.astro"
import MetadataConfig from "@astro/configurations/metadata.config.json"
import BaseLayout from "@astro/layouts/base-layout.astro"
import { ClientRouter } from "astro:transitions"

interface Props {
    className?: string | undefined
    description?: string | undefined
    title?: string | undefined
}

const { description = "", title = "" } = Astro.props
---

<!doctype html>
<html lang={MetadataConfig.language}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body class="base-body">
        <BaseNoscript />

        <BaseLayout>
            <slot />
        </BaseLayout>
    </body>
</html>

<style is:global>
    @layer bootstrap, root, components, important;

    @import "bootstrap/dist/css/bootstrap.min.css" layer(bootstrap);

    @layer root {
        .base-body {
            width: 100svw;
            height: 100svh;
        }
    }
</style>
