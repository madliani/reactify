---
import BaseNoscript from "@astro/blocks/base-noscript.astro"
import Metadata from "@astro/blocks/metadata.astro"
import MetadataConfig from "@astro/configurations/metadata.config.json"
import BaseLayout from "@astro/layouts/base-layout.astro"

import "@astro/styles/global.tw.css"
import { ClientRouter } from "astro:transitions"

interface Props {
    description?: string | undefined
    title?: string | undefined
}

const { description = "", title = "" } = Astro.props
---

<!doctype html>
<html lang={MetadataConfig.language}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body class="base-template">
        <BaseNoscript />

        <BaseLayout>
            <slot />
        </BaseLayout>
    </body>
</html>

<style is:global>
    @reference "tailwindcss";

    @layer components {
        .base-template {
            @apply bg-gray-50;
            @apply h-dvh;
            @apply w-dvw;

            @apply sm:h-screen;
            @apply sm:w-screen;
        }
    }
</style>
