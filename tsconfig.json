{
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "lib": [
            "DOM.AsyncIterable",
            "DOM.Iterable",
            "DOM",
            "ES2022.array",
            "ES2022.error",
            "ES2022.intl",
            "ES2022.object",
            "ES2022.regExp",
            "ES2022.string",
            "ES2022"
        ],
        "paths": {
            "@astro/*": ["${configDir}/astro/*"],
            "@react/*": ["${configDir}/react/*"]
        },
        "types": ["astro/astro-jsx", "astro/client", "react-dom", "react"]
    },
    "exclude": [
        "${configDir}/.vitest/",
        "${configDir}/coverage/",
        "${configDir}/dist/",
        "${configDir}/node_modules/"
    ],
    "extends": "./tsconfig.base.json",
    "include": [
        "${configDir}/.astro/*.d.ts",
        "${configDir}/astro/**/*.astro",
        "${configDir}/astro/**/*.ts",
        "${configDir}/react/**/*.ts",
        "${configDir}/react/**/*.tsx",
        "${configDir}/tests/*.ts",
        "${configDir}/types/*.d.ts"
    ]
}
