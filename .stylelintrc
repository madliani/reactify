{
    "extends": ["stylelint-config-clean-order", "stylelint-config-standard"],
    "plugins": [
        "stylelint-no-unsupported-browser-features",
        "stylelint-order",
        "stylelint-selector-bem-pattern"
    ],
    "rules": {
        "plugin/no-unsupported-browser-features": [
            true,
            {
                "severity": "error"
            }
        ]
    }
}
