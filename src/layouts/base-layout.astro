---
import BaseFooter from "@src/blocs/base-footer.astro"
import Header from "@src/blocs/header.astro"
import Main from "@src/blocs/main.astro"
---

<div class="base-layout">
    <Header />

    <Main>
        <slot />
    </Main>

    <BaseFooter />
</div>

<style is:global>
    .base-layout {
        display: flex;
        flex-flow: column nowrap;
        gap: 0;
        align-items: stretch;
        justify-content: space-between;

        width: 100svw;
        height: 100svh;

        @media only screen and (width >= 640px) {
            padding-inline: 3rem;
        }
    }
</style>
