---
import BaseFooter from "@src/blocs/base-footer.astro"
import BaseHeader from "@src/blocs/base-header.astro"
import BaseMain from "@src/blocs/base-main.astro"
---

<div class="base-layout">
    <BaseHeader />

    <BaseMain>
        <slot />
    </BaseMain>

    <BaseFooter />
</div>

<style is:global>
    .base-layout {
        display: flex;
        flex-flow: column nowrap;
        gap: 0;
        align-items: stretch;
        justify-content: space-between;

        width: 100svw;
        height: 100svh;

        @media only screen and (width >= 640px) {
            padding-inline: 3rem;
        }
    }
</style>
