---
import { Theme as RadixUITheme } from "@radix-ui/themes"
import { twMerge } from "tailwind-merge"

interface Props {
    className?: string | undefined
}

const { className } = Astro.props
---

<RadixUITheme className={twMerge(className, "h-[100svh]", "w-[100svw]")}>
    <slot />
</RadixUITheme>
