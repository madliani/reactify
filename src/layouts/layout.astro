---
import "@fontsource-variable/playfair-display"
import Footer from "@src/blocs/footer.astro"
import Header from "@src/blocs/header.astro"
import Main from "@src/blocs/main.astro"
import Metadata from "@src/blocs/metadata.astro"
import Noscript from "@src/blocs/noscript.astro"
import MetadataConfig from "@src/configurations/metadata.config.json"
import { ClientRouter } from "astro:transitions"

interface Props {
    description?: string
    title?: string
}

const { description = "", title = "" } = Astro.props
---

<!doctype html>
<html lang={MetadataConfig.language}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body class="body">
        <Noscript />

        <div class="layout">
            <Header />

            <Main>
                <slot />
            </Main>

            <Footer />
        </div>
    </body>
</html>

<style is:global>
    @import "tailwindcss";
    @import "@heroui/styles";

    /* See https://web.dev/articles/prefers-reduced-motion. */
    @media (prefers-reduced-motion: reduce) {
        *,
        ::before,
        ::after {
            scroll-behavior: auto !important;

            background-attachment: initial !important;

            transition-delay: -1ms !important;
            transition-duration: 1ms !important;
            animation-duration: 1ms !important;
            animation-delay: -1ms !important;
            animation-iteration-count: 1 !important;
        }
    }

    .body {
        margin: 0;
        padding: 0;

        width: 100svw;
        height: 100svh;
    }

    .layout {
        display: flex;
        flex-flow: column nowrap;
        gap: 0;
        align-items: stretch;
        justify-content: space-between;

        width: 100svw;
        height: 100svh;

        @media only screen and (width >= 640px) {
            padding-inline: 3rem;
        }
    }
</style>
