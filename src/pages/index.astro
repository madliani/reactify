---
import "@fontsource-variable/playfair-display"

// This path notation is necessary for Astro to work correctly with React
import BaseTemplate from "@src/templates/base-template.astro"
import { Counter } from "../react/components/Counter/Counter"
---

<BaseTemplate title="Home">
    <Counter client:load />
</BaseTemplate>

<style is:global>
    @import "tailwindcss";
    @import "@heroui/styles";

    /* For details, see https://web.dev/articles/prefers-reduced-motion. */
    @media (prefers-reduced-motion: reduce) {
        *,
        ::before,
        ::after {
            scroll-behavior: auto !important;

            background-attachment: initial !important;

            transition-delay: -1ms !important;
            transition-duration: 1ms !important;
            animation-duration: 1ms !important;
            animation-delay: -1ms !important;
            animation-iteration-count: 1 !important;
        }
    }

    :root,
    body {
        margin: 0;
        padding: 0;

        min-width: 100svw;
        min-height: 100svh;
    }
</style>
