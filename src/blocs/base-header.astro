---
import { Image } from "astro:assets"
---

<header class="base-header">
    <Image
        alt="Reactify logo"
        src="/icons/favicon.svg"
        title="Reactify logo"
        width={96}
        height={96}
    />
</header>

<style is:global>
    .base-header {
        display: flex;
        flex-flow: column nowrap;
        gap: 0;
        align-items: center;
        justify-content: center;

        min-width: 100%;
        min-height: 10svh;

        @media only screen and (width >= 640px) {
            flex-direction: row;
            justify-content: space-between;
        }
    }
</style>
