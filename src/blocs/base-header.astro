---
import { Image } from "astro:assets"
---

<header class="base-header">
    <Image
        alt="Reactify logo"
        src="/icons/favicon.svg"
        title="Reactify logo"
        width={96}
        height={96}
    />
</header>

<style is:global>
    @layer components {
        .base-header {
            display: flex;
            flex-flow: column nowrap;
            gap: 0;
            align-items: center;
            justify-content: center;

            min-width: var(--full-width);
            min-height: 10svh;

            @media (width >= 640px) {
                flex-direction: row;
                justify-content: space-between;
            }
        }
    }
</style>
