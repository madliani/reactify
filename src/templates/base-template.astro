---
import { Theme } from "@radix-ui/themes"
import Metadata from "@src/blocs/metadata.astro"
import Noscript from "@src/blocs/noscript.astro"
import MetadataConfig from "@src/configurations/metadata.config.json"
import BaseLayout from "@src/layouts/base-layout.astro"
import { ClientRouter } from "astro:transitions"

interface Props {
    description?: string
    title?: string
}

const { description = "", title = "" } = Astro.props
---

<!doctype html>
<html lang={MetadataConfig.language}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body>
        <Noscript />

        <Theme>
            <BaseLayout>
                <slot />
            </BaseLayout>
        </Theme>
    </body>
</html>

<style is:global>
    @layer vendor, root, components.mobile, components.media, important;

    @import "@radix-ui/themes/styles.css" layer(vendor.radix-ui);

    @layer root {
        :root {
            --full-width: 100%;
            --screen-width: 100svw;
            --screen-height: 100svh;
        }
    }

    @layer important {
        /* For details, see https://web.dev/articles/prefers-reduced-motion. */
        @media (prefers-reduced-motion: reduce) {
            *,
            ::before,
            ::after {
                scroll-behavior: auto !important;

                background-attachment: initial !important;

                transition-delay: -1ms !important;
                transition-duration: 1ms !important;
                animation-duration: 1ms !important;
                animation-delay: -1ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    }
</style>
