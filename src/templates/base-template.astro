---
import { Theme as RadixUITheme } from "@radix-ui/themes"
import BaseNoscript from "@src/blocks/base-noscript.astro"
import Metadata from "@src/blocks/metadata.astro"
import MetadataConfig from "@src/configurations/metadata.config.json"
import BaseLayout from "@src/layouts/base-layout.astro"
import { ClientRouter } from "astro:transitions"

interface Props {
    description?: string
    title?: string
}

const { description = "", title = "" } = Astro.props
---

<!doctype html>
<html lang={MetadataConfig.language}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body>
        <BaseNoscript />

        <RadixUITheme>
            <BaseLayout>
                <slot />
            </BaseLayout>
        </RadixUITheme>
    </body>
</html>

<style is:global>
    @layer theme, base, components, utilities, vendor, important;

    @import "tailwindcss/theme.css" layer(theme);
    @import "tailwindcss/preflight.css" layer(base);
    @import "tailwindcss/utilities.css" layer(utilities);

    @import "@radix-ui/themes/styles.css" layer(vendor.radix-ui);

    @layer base {
        :root {
            --full-width: 100%;
        }
    }

    @layer components {
        @layer mobile, media;
    }

    @layer important {
        /* For details, see https://web.dev/articles/prefers-reduced-motion. */
        @media (prefers-reduced-motion: reduce) {
            *,
            ::before,
            ::after {
                scroll-behavior: auto !important;

                background-attachment: initial !important;

                transition-delay: -1ms !important;
                transition-duration: 1ms !important;
                animation-duration: 1ms !important;
                animation-delay: -1ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    }
</style>
