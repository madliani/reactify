---
import BaseNoscript from "@src/blocks/base-noscript.astro"
import Metadata from "@src/blocks/metadata.astro"
import MetadataConfig from "@src/configurations/metadata.config.json"
import BaseLayout from "@src/layouts/base-layout.astro"
import { ClientRouter } from "astro:transitions"

interface Props {
    className?: string | undefined
    description?: string | undefined
    title?: string | undefined
}

const { className, description = "", title = "" } = Astro.props
---

<!doctype html>
<html lang={MetadataConfig.language}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body class="h-[100svh] w-[100svw]">
        <BaseNoscript />

        <BaseLayout className={className}>
            <slot />
        </BaseLayout>
    </body>
</html>
