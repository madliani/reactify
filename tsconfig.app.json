{
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "lib": [
            "DOM",
            "DOM.AsyncIterable",
            "DOM.Iterable",
            "ES2022.array",
            "ES2022.error",
            "ES2022.intl",
            "ES2022.object",
            "ES2022.regExp",
            "ES2022.string",
            "ES2022"
        ],
        "noEmit": false,
        "paths": { "@src/*": ["${configDir}/src/*"] },
        "types": ["astro/astro-jsx", "astro/client", "react", "react-dom"]
    },
    "exclude": [
        "${configDir}/.vitest/",
        "${configDir}/coverage/",
        "${configDir}/dist/",
        "${configDir}/node_modules/"
    ],
    "extends": "./tsconfig.base.json",
    "include": [
        "${configDir}/.astro/types.d.ts",
        "${configDir}/src/**/*.astro",
        "${configDir}/src/**/*.test.ts",
        "${configDir}/src/**/*.test.tsx",
        "${configDir}/src/**/*.ts",
        "${configDir}/src/**/*.tsx"
    ]
}
