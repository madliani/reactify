{
    "name": "reactify",
    "version": "6.2.0",
    "private": true,
    "description": "A simple starter kit for React.",
    "keywords": [
        "astro",
        "heroui",
        "react",
        "reactify",
        "tailwindcss",
        "typescript"
    ],
    "homepage": "https://github.com/madliani/reactify#readme",
    "bugs": {
        "url": "https://github.com/madliani/reactify/issues",
        "email": "unixsocket@hotmail.com"
    },
    "license": "UNLICENSED",
    "author": {
        "name": "madliani",
        "email": "unixsocket@hotmail.com",
        "url": "https://madliani.github.io/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/madliani/reactify.git"
    },
    "os": [
        "linux"
    ],
    "cpu": [
        "x64"
    ],
    "type": "module",
    "scripts": {
        "build": "astro build",
        "check": "oxlint --fix & tsrs --fast & oxfmt --write",
        "check:spell": "cspell",
        "check:styles": "stylelint --fix ./",
        "lint-staged": "lint-staged",
        "prepare": "husky",
        "serve": "astro dev",
        "serve:preview": "astro preview",
        "telemetry:disable": "astro telemetry disable",
        "test": "vitest run",
        "test:coverage": "vitest run",
        "test:ui": "vitest watch --ui"
    },
    "dependencies": {
        "@astrojs/react": "7.1.9",
        "@astrojs/sitemap": "3.7.6",
        "@fontsource-variable/playfair-display": "5.3.0",
        "@fortawesome/fontawesome-free": "7.3.1",
        "@fortawesome/free-brands-svg-icons": "7.3.1",
        "@fortawesome/free-regular-svg-icons": "7.3.1",
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "@fortawesome/react-fontawesome": "3.5.0",
        "@heroui/react": "3.2.7",
        "@heroui/styles": "3.2.7",
        "@nanostores/react": "2.0.1",
        "@tailwindcss/vite": "4.3.5",
        "astro": "7.4.13",
        "es-toolkit": "1.53.2",
        "pathe": "2.0.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sharp": "0.35.5",
        "tailwindcss": "4.3.5",
        "tslib": "2.9.1",
        "tsrs": "7.1.0-beta.tsrs4"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@astrojs/compiler-rs": "0.5.3",
        "@cspell/dict-ru_ru": "2.3.4",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "8.0.0",
        "@testing-library/react": "16.3.3",
        "@testing-library/react-hooks": "8.0.1",
        "@testing-library/user-event": "14.6.13",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "@vitest/coverage-v8": "5.1.1",
        "@vitest/ui": "5.1.1",
        "cspell": "10.5.2",
        "happy-dom": "21.0.4",
        "husky": "9.1.7",
        "lint-staged": "17.6.1",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "stylelint": "18.1.0",
        "stylelint-config-clean-order": "10.0.0",
        "stylelint-config-html": "2.0.0",
        "stylelint-config-standard": "41.1.0",
        "stylelint-config-tailwindcss": "1.0.1",
        "stylelint-no-unsupported-browser-features": "8.1.2",
        "stylelint-order": "8.1.3",
        "vitest": "5.1.1"
    },
    "engines": {
        "node": ">=26.3.0"
    },
    "engineStrict": false
}
